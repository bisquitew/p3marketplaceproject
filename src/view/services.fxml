<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="controller.ServicesController"
            prefWidth="1100" prefHeight="700">

    <top>
        <ToolBar>
            <Label text="Available Services" styleClass="title"/>
            <Pane HBox.hgrow="ALWAYS"/>
            <Button text="Toggle Dark Mode" onAction="#onToggleDarkMode" styleClass="secondary"/>
            <Button text="Back" onAction="#onBack" styleClass="secondary"/>
        </ToolBar>
    </top>

    <center>
        <VBox spacing="15">
            <padding><Insets top="15" right="20" bottom="20" left="20"/></padding>

            <HBox spacing="10" alignment="CENTER_LEFT">
                <TextField fx:id="categoryField" promptText="Search Category" maxWidth="200"/>
                <TextField fx:id="cityField" promptText="Search City" maxWidth="200"/>
                <Button text="Search" onAction="#onSearch"/>
            </HBox>

            <TableView fx:id="servicesTable" prefHeight="400" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="idColumn" text="ID" prefWidth="60"/>
                    <TableColumn fx:id="titleColumn" text="Service Title" prefWidth="250"/>
                    <TableColumn fx:id="cityColumn" text="Location" prefWidth="150"/>
                    <TableColumn fx:id="categoryColumn" text="Category" prefWidth="150"/>
                    <TableColumn fx:id="priceColumn" text="Price (RON)" prefWidth="100"/>
                </columns>
            </TableView>

            <Separator/>

            <VBox spacing="10">
                <Label text="Book Selected Service" styleClass="title" style="-fx-font-size: 18;"/>
                <HBox spacing="10" alignment="CENTER_LEFT">
                    <TextField fx:id="bookingAddressField" promptText="Delivery Address" prefWidth="250"/>
                    <Label text="Date:"/>
                    <DatePicker fx:id="datePicker" prefWidth="150"/>
                    <Label text="Time:"/>
                    <ComboBox fx:id="hourCombo" prefWidth="75"/>
                    <Label text=":"/>
                    <ComboBox fx:id="minuteCombo" prefWidth="75"/>
                    <Button text="Book Service Now" onAction="#onBookService"/>
                </HBox>
            </VBox>

            <Label fx:id="infoLabel" styleClass="subtitle" wrapText="true"/>
        </VBox>
    </center>
</BorderPane>