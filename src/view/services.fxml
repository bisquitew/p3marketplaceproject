<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="controller.ServicesController">

    <top>
        <ToolBar>
            <Label text="Available Services" styleClass="title"/>
            <Pane HBox.hgrow="ALWAYS"/>
            <Button text="Back" onAction="#onBack" styleClass="secondary"/>
        </ToolBar>
    </top>

    <center>
        <VBox spacing="15">
            <padding><Insets top="20" right="20" bottom="20" left="20"/></padding>

            <HBox spacing="10">
                <TextField fx:id="categoryField" promptText="Category"/>
                <TextField fx:id="cityField" promptText="City"/>
                <Button text="Search" onAction="#onSearch"/>
            </HBox>

            <TableView fx:id="servicesTable">
                <columns>
                    <TableColumn fx:id="idColumn" text="ID" prefWidth="60"/>
                    <TableColumn fx:id="titleColumn" text="Title" prefWidth="200"/>
                    <TableColumn fx:id="cityColumn" text="City" prefWidth="120"/>
                    <TableColumn fx:id="priceColumn" text="Price" prefWidth="100"/>
                </columns>
            </TableView>

            <Button text="Book Selected Service" onAction="#onMakeBooking" maxWidth="200"/>
            <Label fx:id="infoLabel" styleClass="error"/>
        </VBox>
    </center>
</BorderPane>
