<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="controller.ServicesController"
            prefWidth="1100" prefHeight="700">

    <top>
        <ToolBar>
            <Label text="Available Services" styleClass="title"/>
            <Pane HBox.hgrow="ALWAYS"/>
            <Button text="Toggle Dark Mode" onAction="#onToggleDarkMode" styleClass="secondary"/>
            <Button text="Back" onAction="#onBack" styleClass="secondary"/>
        </ToolBar>
    </top>

    <center>
        <VBox spacing="12">
            <padding><Insets top="15" right="20" bottom="20" left="20"/></padding>

            <HBox spacing="10">
                <TextField fx:id="categoryField" promptText="Category" maxWidth="200"/>
                <TextField fx:id="cityField" promptText="City" maxWidth="200"/>
                <Button text="Search" onAction="#onSearch" maxWidth="100"/>
            </HBox>

            <TableView fx:id="servicesTable" prefHeight="450">
                <columns>
                    <TableColumn fx:id="idColumn" text="ID" prefWidth="60"/>
                    <TableColumn fx:id="titleColumn" text="Title" prefWidth="200"/>
                    <TableColumn fx:id="cityColumn" text="City" prefWidth="150"/>
                    <TableColumn fx:id="categoryColumn" text="Category" prefWidth="150"/>
                    <TableColumn fx:id="priceColumn" text="Price" prefWidth="100"/>
                </columns>
            </TableView>

            <Label fx:id="infoLabel" styleClass="error" wrapText="true" maxWidth="600"/>
        </VBox>
    </center>
</BorderPane>
