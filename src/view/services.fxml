<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="controller.ServicesController"
            prefWidth="1100" prefHeight="700">

    <top>
        <HBox styleClass="header-bar" alignment="CENTER_LEFT" spacing="20">
            <Button text="← Dashboard" onAction="#onBack" styleClass="secondary"/>
            <Label text="Available Services" styleClass="title"/>
            <Pane HBox.hgrow="ALWAYS"/>
            <Button text="Dark Mode" onAction="#onToggleDarkMode" styleClass="secondary"/>
        </HBox>
    </top>

    <center>
        <VBox spacing="20" style="-fx-padding: 30;">

            <HBox spacing="15" alignment="CENTER_LEFT" styleClass="card-container">
                <TextField fx:id="categoryField" promptText="Category (e.g. Plumbing)" prefWidth="200"/>
                <TextField fx:id="cityField" promptText="City" prefWidth="200"/>
                <Button text="Search" onAction="#onSearch"/>
            </HBox>

            <TableView fx:id="servicesTable" VBox.vgrow="ALWAYS" style="-fx-control-inner-background: white; -fx-text-fill: black;">
                <columns>
                    <TableColumn fx:id="idColumn" text="ID" prefWidth="50" style="-fx-text-fill: black;"/>
                    <TableColumn fx:id="titleColumn" text="Service" prefWidth="200" style="-fx-text-fill: black;"/>
                    <TableColumn fx:id="categoryColumn" text="Category" prefWidth="150" style="-fx-text-fill: black;"/>
                    <TableColumn fx:id="cityColumn" text="City" prefWidth="150" style="-fx-text-fill: black;"/>
                    <TableColumn fx:id="priceColumn" text="Price (RON)" prefWidth="100" style="-fx-text-fill: black;"/>
                </columns>
                <columnResizePolicy>
                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                </columnResizePolicy>
            </TableView>

            <HBox spacing="15" alignment="CENTER_LEFT" styleClass="card-container">
                <Label text="Book Selected:" style="-fx-font-weight: bold;"/>
                <TextField fx:id="bookingAddressField" promptText="Your Address" prefWidth="250"/>
                <DatePicker fx:id="datePicker" prefWidth="120"/>
                <ComboBox fx:id="hourCombo" prefWidth="70"/>
                <Label text=":"/>
                <ComboBox fx:id="minuteCombo" prefWidth="70"/>
                <Button text="Confirm Booking" onAction="#onBookService" style="-fx-background-color: #10B981;"/>
            </HBox>

            <Label fx:id="infoLabel" styleClass="error"/>
        </VBox>
    </center>
</BorderPane>