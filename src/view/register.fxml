<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="controller.RegisterController"
            prefWidth="1100" prefHeight="700">

    <center>
        <StackPane>
            <VBox spacing="12"
                  alignment="CENTER"
                  maxWidth="480"
                  styleClass="card-container">
                <Label text="Create Account"
                       styleClass="title"
                       wrapText="true"/>
                <Label text="Join the Handyman Marketplace and find or offer services easily."
                       styleClass="subtitle"
                       wrapText="true"
                       maxWidth="420"/>

                <TextField fx:id="usernameField"
                           promptText="Username"
                           maxWidth="420"/>
                <PasswordField fx:id="passwordField"
                               promptText="Password"
                               maxWidth="420"/>
                <TextField fx:id="fullNameField"
                           promptText="Full Name"
                           maxWidth="420"/>
                <TextField fx:id="emailField"
                           promptText="Email"
                           maxWidth="420"/>
                <ComboBox fx:id="roleCombo"
                          promptText="Select Role"
                          maxWidth="420"/>

                <Button text="Register"
                        onAction="#onRegister"
                        maxWidth="420"/>
                <Button text="Back to Login"
                        onAction="#onBack"
                        maxWidth="420"
                        styleClass="secondary"/>
                <Button text="Toggle Dark Mode"
                        onAction="#onToggleDarkMode"
                        maxWidth="420"
                        styleClass="secondary"/>

                <Label fx:id="errorLabel"
                       styleClass="error"
                       wrapText="true"
                       maxWidth="420"/>
            </VBox>
        </StackPane>
    </center>
</BorderPane>
