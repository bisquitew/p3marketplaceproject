<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<BorderPane xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml" fx:controller="controller.RegisterController" prefWidth="1100" prefHeight="700">
    <center>
        <VBox alignment="CENTER" spacing="20">
            <VBox spacing="25" alignment="CENTER" maxWidth="500" styleClass="card-container">
                <padding><Insets top="40" right="40" bottom="40" left="40"/></padding>

                <Label text="Create Account" styleClass="title"/>
                <Label text="Join our community today." styleClass="subtitle"/>

                <VBox spacing="15" maxWidth="400">
                    <TextField fx:id="usernameField" promptText="Username" prefHeight="40"/>
                    <PasswordField fx:id="passwordField" promptText="Password" prefHeight="40"/>
                    <TextField fx:id="fullNameField" promptText="Full Name" prefHeight="40"/>
                    <TextField fx:id="emailField" promptText="Email Address" prefHeight="40"/>
                    <ComboBox fx:id="roleCombo" promptText="Select Account Type" prefWidth="400" prefHeight="40"/>
                    <Label fx:id="errorLabel" styleClass="error" style="-fx-text-fill: red;"/>
                </VBox>

                <Button text="Register Now" onAction="#onRegister" prefWidth="400" prefHeight="45"/>

                <HBox alignment="CENTER" spacing="10">
                    <Label text="Already have an account?" styleClass="subtitle"/>
                    <Hyperlink text="Sign In" onAction="#onBack" style="-fx-text-fill: #2563EB;"/>
                </HBox>
            </VBox>
            <Button text="🌓 Theme" onAction="#onToggleDarkMode" styleClass="secondary"/>
        </VBox>
    </center>
</BorderPane>