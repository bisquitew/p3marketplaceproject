<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="controller.BookingsController">

    <top>
        <ToolBar>
            <Label text="My Bookings" styleClass="title"/>
            <Pane HBox.hgrow="ALWAYS"/>
            <Button text="Toggle Dark Mode" onAction="#onToggleDarkMode" styleClass="secondary"/>
            <Button text="Back" onAction="#onBack" styleClass="secondary"/>
        </ToolBar>
    </top>

    <center>
        <VBox spacing="15">
            <padding><Insets top="20" right="20" bottom="20" left="20"/></padding>

            <TableView fx:id="bookingsTable">
                <columns>
                    <TableColumn fx:id="idColumn" text="ID" prefWidth="60"/>
                    <TableColumn fx:id="serviceColumn" text="Service ID" prefWidth="80"/>
                    <TableColumn fx:id="dateColumn" text="Date" prefWidth="160"/>
                    <TableColumn fx:id="statusColumn" text="Status" prefWidth="100"/>
                    <TableColumn fx:id="addressColumn" text="Address" prefWidth="220"/>
                    <TableColumn fx:id="priceColumn" text="Price" prefWidth="80"/>
                </columns>
            </TableView>

            <HBox spacing="10" alignment="CENTER">
                <Button text="Refresh" onAction="#onRefresh"/>
                <Button text="Add Review" onAction="#onAddReview"/>
            </HBox>

            <Label fx:id="infoLabel" styleClass="info"/>
        </VBox>
    </center>
</BorderPane>
