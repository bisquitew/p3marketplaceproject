<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="controller.BookingsController"
            prefWidth="1100" prefHeight="700">

    <top>
        <ToolBar>
            <Label text="Booking History" styleClass="title"/>
            <Pane HBox.hgrow="ALWAYS"/>
            <Button text="Toggle Theme" onAction="#onToggleDarkMode" styleClass="secondary"/>
            <Button text="Back" onAction="#onBack" styleClass="secondary"/>
        </ToolBar>
    </top>

    <center>
        <VBox spacing="20">
            <padding>
                <Insets top="25" right="30" bottom="25" left="30"/>
            </padding>

            <VBox spacing="15" styleClass="card-container" VBox.vgrow="ALWAYS">
                <TableView fx:id="bookingsTable" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="idColumn" text="ID" prefWidth="70"/>
                        <TableColumn fx:id="serviceColumn" text="Service ID" prefWidth="100"/>
                        <TableColumn fx:id="dateColumn" text="Scheduled Date" prefWidth="180"/>
                        <TableColumn fx:id="statusColumn" text="Status" prefWidth="120"/>
                        <TableColumn fx:id="addressColumn" text="Delivery Address" prefWidth="300"/>
                        <TableColumn fx:id="priceColumn" text="Total" prefWidth="100"/>
                    </columns>
                </TableView>

                <HBox spacing="15" alignment="CENTER_LEFT">
                    <Button text="Refresh List" onAction="#onRefresh"/>
                    <Button text="Leave a Review" onAction="#onAddReview" styleClass="main-btn"/>
                </HBox>
            </VBox>

            <Label fx:id="infoLabel" styleClass="subtitle"/>
        </VBox>
    </center>
</BorderPane>