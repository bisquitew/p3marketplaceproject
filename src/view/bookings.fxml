<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="controller.BookingsController"
            prefWidth="1100" prefHeight="700">

    <top>
        <ToolBar>
            <Label text="My Bookings" styleClass="title"/>
            <Pane HBox.hgrow="ALWAYS"/>
            <Button text="Toggle Dark Mode" onAction="#onToggleDarkMode" styleClass="secondary"/>
            <Button text="Back" onAction="#onBack" styleClass="secondary"/>
        </ToolBar>
    </top>

    <center>
        <VBox spacing="12">
            <padding>
                <Insets top="15" right="20" bottom="20" left="20"/>
            </padding>

            <TableView fx:id="bookingsTable" prefHeight="470" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="idColumn" text="ID" prefWidth="60"/>
                    <TableColumn fx:id="serviceColumn" text="Service ID" prefWidth="100"/>
                    <TableColumn fx:id="dateColumn" text="Scheduled Date" prefWidth="180"/>
                    <TableColumn fx:id="statusColumn" text="Status" prefWidth="100"/>
                    <TableColumn fx:id="addressColumn" text="Address" prefWidth="260"/>
                    <TableColumn fx:id="priceColumn" text="Total Price" prefWidth="100"/>
                </columns>
            </TableView>

            <HBox spacing="10" alignment="CENTER">
                <Button text="Refresh" onAction="#onRefresh"/>
                <Button text="Add Review" onAction="#onAddReview"/>
            </HBox>

            <Label fx:id="infoLabel" styleClass="subtitle" wrapText="true" maxWidth="800"/>
        </VBox>
    </center>
</BorderPane>