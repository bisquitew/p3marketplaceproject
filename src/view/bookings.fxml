<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="controller.BookingsController"
            prefWidth="1100" prefHeight="700">

    <top>
        <ToolBar>
            <Label text="My Bookings"
                   styleClass="title"
                   wrapText="true"/>
            <Pane HBox.hgrow="ALWAYS"/>
            <Button text="Toggle Dark Mode"
                    onAction="#onToggleDarkMode"
                    styleClass="secondary"/>
            <Button text="Back"
                    onAction="#onBack"
                    styleClass="secondary"/>
        </ToolBar>
    </top>

    <center>
        <VBox spacing="12">
            <padding>
                <Insets top="15" right="20" bottom="20" left="20"/>
            </padding>

            <TableView fx:id="bookingsTable"
                       prefHeight="470">
                <columns>
                    <TableColumn fx:id="idColumn"
                                 text="ID"
                                 prefWidth="60"
                                 minWidth="60"
                                 maxWidth="80"/>
                    <TableColumn fx:id="serviceColumn"
                                 text="Service ID"
                                 prefWidth="90"
                                 minWidth="80"
                                 maxWidth="110"/>
                    <TableColumn fx:id="dateColumn"
                                 text="Date"
                                 prefWidth="180"
                                 minWidth="150"/>
                    <TableColumn fx:id="statusColumn"
                                 text="Status"
                                 prefWidth="100"
                                 minWidth="90"
                                 maxWidth="130"/>
                    <TableColumn fx:id="addressColumn"
                                 text="Address"
                                 prefWidth="260"
                                 minWidth="200"/>
                    <TableColumn fx:id="priceColumn"
                                 text="Price"
                                 prefWidth="90"
                                 minWidth="80"
                                 maxWidth="110"/>
                </columns>
            </TableView>

            <HBox spacing="10" alignment="CENTER">
                <Button text="Refresh" onAction="#onRefresh"/>
                <Button text="Add Review" onAction="#onAddReview"/>
            </HBox>

            <Label fx:id="infoLabel"
                   styleClass="info"
                   wrapText="true"
                   maxWidth="600"/>
        </VBox>
    </center>
</BorderPane>
