<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="controller.BookingsController"
            prefWidth="1100" prefHeight="700">

    <top>
        <HBox styleClass="header-bar" alignment="CENTER_LEFT" spacing="20">
            <Button text="← Dashboard" onAction="#onBack" styleClass="secondary"/>
            <Label text="My Bookings" styleClass="title"/>
            <Pane HBox.hgrow="ALWAYS"/>
            <Button text="Refresh" onAction="#onRefresh" styleClass="secondary"/>
            <Button text="Dark Mode" onAction="#onToggleDarkMode" styleClass="secondary"/>
        </HBox>
    </top>

    <center>
        <VBox spacing="20" style="-fx-padding: 30;">
            <TableView fx:id="bookingsTable" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="idColumn" text="ID" prefWidth="50"/>
                    <TableColumn fx:id="serviceColumn" text="Service ID" prefWidth="80"/>
                    <TableColumn fx:id="dateColumn" text="Date &amp; Time" prefWidth="150"/>
                    <TableColumn fx:id="statusColumn" text="Status" prefWidth="100"/>
                    <TableColumn fx:id="addressColumn" text="Address" prefWidth="200"/>
                    <TableColumn fx:id="priceColumn" text="Price" prefWidth="80"/>
                    <TableColumn fx:id="actionColumn" text="Action" prefWidth="100"/>
                </columns>
                <columnResizePolicy>
                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                </columnResizePolicy>
            </TableView>

            <HBox spacing="15" alignment="CENTER_RIGHT">
                <Button text="★ Write Review" onAction="#onAddReview" style="-fx-background-color: #F59E0B;"/>
            </HBox>
            <Label fx:id="infoLabel" styleClass="error"/>
        </VBox>
    </center>
</BorderPane>