<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<BorderPane xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml" fx:controller="controller.CustomerDashboardController">
    <top>
        <HBox style="-fx-background-color: white; -fx-padding: 15; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.05), 5, 0, 0, 2);" alignment="CENTER_LEFT">
            <Label text="🏠 Marketplace" style="-fx-font-weight: bold; -fx-font-size: 18;"/>
            <Pane HBox.hgrow="ALWAYS"/>
            <Button text="Logout" onAction="#onLogout" styleClass="secondary"/>
        </HBox>
    </top>
    <center>
        <VBox alignment="TOP_CENTER" spacing="40" style="-fx-padding: 50;">
            <VBox spacing="10" alignment="CENTER">
                <Label fx:id="welcomeLabel" styleClass="title" />
                <Label text="What would you like to do today?" styleClass="subtitle" />
            </VBox>

            <HBox spacing="30" alignment="CENTER">
                <VBox spacing="20" alignment="CENTER" styleClass="card-container" prefWidth="300">
                    <Label text="🔍" style="-fx-font-size: 40;"/>
                    <Label text="Find Services" styleClass="title" style="-fx-font-size: 20;"/>
                    <Label text="Explore plumbers, electricians, and more." wrapText="true" alignment="CENTER" textAlignment="CENTER"/>
                    <Button text="Browse All" onAction="#onGoToServices" prefWidth="200"/>
                </VBox>

                <VBox spacing="20" alignment="CENTER" styleClass="card-container" prefWidth="300">
                    <Label text="📅" style="-fx-font-size: 40;"/>
                    <Label text="My Bookings" styleClass="title" style="-fx-font-size: 20;"/>
                    <Label text="Check status and manage your appointments." wrapText="true" alignment="CENTER" textAlignment="CENTER"/>
                    <Button text="View Schedule" onAction="#onGoToBookings" prefWidth="200"/>
                </VBox>
            </HBox>

            <Button text="🌓 Toggle Appearance" onAction="#onToggleDarkMode" styleClass="secondary"/>
        </VBox>
    </center>
</BorderPane>