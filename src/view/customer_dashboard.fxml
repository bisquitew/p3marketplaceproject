<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="controller.CustomerDashboardController">

    <top>
        <ToolBar>
            <Label text="Handyman Marketplace" styleClass="title"/>
            <Pane HBox.hgrow="ALWAYS"/>
            <Button text="Services" onAction="#onGoToServices" styleClass="secondary"/>
            <Button text="My Bookings" onAction="#onGoToBookings" styleClass="secondary"/>
            <Button text="Logout" onAction="#onLogout"/>
        </ToolBar>
    </top>

    <center>
        <StackPane>
            <VBox alignment="CENTER" spacing="20" maxWidth="500" styleClass="card-container">
                <Label fx:id="welcomeLabel" styleClass="title"/>
                <Label text="Use the top menu to browse services or view your bookings."/>
            </VBox>
        </StackPane>
    </center>
</BorderPane>
