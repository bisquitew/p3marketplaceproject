<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="controller.CustomerDashboardController"
            prefWidth="1100" prefHeight="700">

    <top>
        <HBox styleClass="header-bar" alignment="CENTER_LEFT" spacing="20">
            <Label text="🏠 Marketplace" style="-fx-font-weight: bold; -fx-font-size: 20;"/>
            <Pane HBox.hgrow="ALWAYS"/>
            <Button text="👤 Logout" onAction="#onLogout" styleClass="secondary"/>
        </HBox>
    </top>

    <center>
        <VBox alignment="CENTER" spacing="40" style="-fx-padding: 40;">

            <VBox spacing="10" alignment="CENTER">
                <Label fx:id="welcomeLabel" styleClass="title" />
                <Label text="Manage your home services efficiently." styleClass="subtitle" />
            </VBox>

            <HBox spacing="40" alignment="CENTER">
                <VBox spacing="20" alignment="CENTER" styleClass="card-container" prefWidth="320" prefHeight="250">
                    <Label text="🔍" style="-fx-font-size: 50;"/>
                    <Label text="Find Services" styleClass="title" style="-fx-font-size: 22;"/>
                    <Label text="Browse active listings for plumbing, cleaning, and repairs."
                           wrapText="true" textAlignment="CENTER" styleClass="subtitle"/>
                    <Button text="Browse Now" onAction="#onGoToServices" prefWidth="200"/>
                </VBox>

                <VBox spacing="20" alignment="CENTER" styleClass="card-container" prefWidth="320" prefHeight="250">
                    <Label text="📅" style="-fx-font-size: 50;"/>
                    <Label text="My Bookings" styleClass="title" style="-fx-font-size: 22;"/>
                    <Label text="Check status, history, and reschedule appointments."
                           wrapText="true" textAlignment="CENTER" styleClass="subtitle"/>
                    <Button text="View Schedule" onAction="#onGoToBookings" prefWidth="200"/>
                </VBox>
            </HBox>

            <Button text="🌓 Toggle Appearance" onAction="#onToggleDarkMode" styleClass="secondary"/>
        </VBox>
    </center>
</BorderPane>