<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="controller.CustomerDashboardController">

    <center>
        <StackPane>
            <VBox alignment="CENTER" spacing="20" maxWidth="500" styleClass="card-container">
                <Label fx:id="welcomeLabel" styleClass="title"/>
                <Label text="Use the buttons below to browse services or view your bookings." styleClass="subtitle"/>
                <HBox spacing="10" alignment="CENTER">
                    <Button text="Services" onAction="#onGoToServices"/>
                    <Button text="My Bookings" onAction="#onGoToBookings"/>
                    <Button text="Logout" onAction="#onLogout"/>
                </HBox>
                <Button text="Toggle Dark Mode" onAction="#onToggleDarkMode" styleClass="secondary"/>
            </VBox>
        </StackPane>
    </center>
</BorderPane>
