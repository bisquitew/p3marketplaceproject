<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="controller.CustomerDashboardController"
            prefWidth="1100" prefHeight="700">
    <center>
        <StackPane>
            <VBox alignment="CENTER" spacing="25" maxWidth="520" styleClass="card-container">
                <Label fx:id="welcomeLabel" styleClass="title" wrapText="true" />
                <Label text="Browse services or manage your existing bookings below."
                       styleClass="subtitle" wrapText="true" />

                <HBox spacing="15" alignment="CENTER">
                    <Button text="Services" onAction="#onGoToServices" prefWidth="150"/>
                    <Button text="My Bookings" onAction="#onGoToBookings" prefWidth="150"/>
                </HBox>

                <Button text="Logout" onAction="#onLogout" styleClass="secondary" prefWidth="120"/>
                <Button text="Toggle Theme" onAction="#onToggleDarkMode" styleClass="secondary" prefWidth="200"/>
            </VBox>
        </StackPane>
    </center>
</BorderPane>