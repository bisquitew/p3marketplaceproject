<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.text.Text?>

<BorderPane xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml" fx:controller="controller.LoginController" prefWidth="1100" prefHeight="700">
    <center>
        <HBox alignment="CENTER">
            <VBox fx:id="heroSection" alignment="CENTER" spacing="20" HBox.hgrow="ALWAYS">
                <Label text="🛠️" style="-fx-font-size: 60px;"/>
                <Label text="Handyman" styleClass="hero-title"/>
                <Label text="Marketplace" styleClass="hero-title" style="-fx-text-fill: white;"/>
                <Label text="The #1 platform for local professionals." styleClass="hero-subtitle" />
            </VBox>

            <VBox spacing="30" alignment="CENTER" prefWidth="550" styleClass="login-form-box">
                <padding><Insets left="60" right="60"/></padding>

                <VBox spacing="5" alignment="CENTER_LEFT">
                    <Label text="Welcome Back" styleClass="title"/>
                    <Label text="Please enter your details to sign in." styleClass="subtitle"/>
                </VBox>

                <VBox spacing="15" maxWidth="350">
                    <TextField fx:id="usernameField" promptText="Username" styleClass="modern-input" prefHeight="45"/>
                    <PasswordField fx:id="passwordField" promptText="Password" styleClass="modern-input" prefHeight="45"/>
                    <Label fx:id="errorLabel" styleClass="error"/>
                </VBox>

                <Button text="Sign In to Dashboard" onAction="#onLogin" prefWidth="350" prefHeight="50"/>

                <HBox alignment="CENTER" spacing="10">
                    <Label text="New here?" styleClass="subtitle"/>
                    <Hyperlink text="Create an account" onAction="#onGoToRegister" style="-fx-text-fill: #2563EB; -fx-font-weight: bold;"/>
                </HBox>

                <Separator maxWidth="200"/>
                <Button text="🌓 Switch Theme" onAction="#onToggleDarkMode" styleClass="secondary" prefWidth="180"/>
            </VBox>
        </HBox>
    </center>
</BorderPane>