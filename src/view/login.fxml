<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="controller.LoginController">

    <center>
        <StackPane>
            <VBox spacing="15" alignment="CENTER" maxWidth="400" styleClass="card-container">
                <Label text="Handyman Marketplace" styleClass="title"/>
                <Label text="Welcome back! Please log in." styleClass="subtitle"/>

                <TextField fx:id="usernameField" promptText="Username"/>
                <PasswordField fx:id="passwordField" promptText="Password"/>

                <Button text="Login" onAction="#onLogin" maxWidth="Infinity"/>
                <Button text="Create an account" onAction="#onGoToRegister" maxWidth="Infinity" styleClass="secondary"/>

                <Label fx:id="errorLabel" styleClass="error"/>
            </VBox>
        </StackPane>
    </center>
</BorderPane>
