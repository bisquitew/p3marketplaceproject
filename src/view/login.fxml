<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.image.*?>
<?import javafx.geometry.Insets?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="controller.LoginController"
            prefWidth="1100" prefHeight="700">

    <center>
        <HBox alignment="CENTER" spacing="0">
            <VBox fx:id="heroSection" alignment="CENTER" spacing="25" HBox.hgrow="ALWAYS">
                <Label text="Handyman Marketplace" styleClass="hero-title" wrapText="true"/>
                <Label text="Connecting customers to quality professionals for various services."
                       styleClass="hero-subtitle" wrapText="true" maxWidth="400"/>
                <ImageView fitWidth="380" preserveRatio="true">
                    <Image url="@handyman_hero.png"/>
                </ImageView>
            </VBox>

            <VBox spacing="25" alignment="CENTER" prefWidth="550" styleClass="login-form-box">
                <padding><Insets left="80" right="80"/></padding>

                <VBox spacing="8">
                    <Label text="Sign In" styleClass="title"/>
                    <Label text="Login or register a new account." styleClass="subtitle"/>
                </VBox>

                <VBox spacing="15" maxWidth="380">
                    <TextField fx:id="usernameField" promptText="Username" styleClass="modern-input"/>
                    <PasswordField fx:id="passwordField" promptText="Password" styleClass="modern-input"/>
                </VBox>

                <Button text="Access Dashboard" onAction="#onLogin" prefWidth="380"/>

                <HBox alignment="CENTER" spacing="10">
                    <Label text="Don't have an account?" styleClass="subtitle"/>
                    <Hyperlink text="Register Now" onAction="#onGoToRegister" style="-fx-text-fill: #F39C12;"/>
                </HBox>

                <Separator maxWidth="300"/>
                <Button text="🌙 Toggle Theme" onAction="#onToggleDarkMode" styleClass="secondary" prefWidth="200"/>
                <Label fx:id="errorLabel" styleClass="error"/>
            </VBox>
        </HBox>
    </center>
</BorderPane>