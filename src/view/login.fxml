<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.image.*?>
<?import javafx.geometry.Insets?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="controller.LoginController"
            prefWidth="1100" prefHeight="700">

    <center>
        <HBox alignment="CENTER" spacing="0">
            <VBox fx:id="heroSection" alignment="CENTER" spacing="25" HBox.hgrow="ALWAYS"
                  styleClass="hero-box">
                <Label text="Handyman Marketplace, hire a Handyman!" styleClass="hero-title" wrapText="true"/>
                <Label text="Connecting certified handymen with quality-driven customers."
                       styleClass="hero-subtitle" wrapText="true" maxWidth="400"/>
                <ImageView fitWidth="380" preserveRatio="true">
                    <Image url="@handyman_hero.png"/>
                </ImageView>
            </VBox>

            <VBox spacing="25" alignment="CENTER" prefWidth="550" style="-fx-background-color: white;">
                <padding><Insets left="80" right="80"/></padding>

                <VBox spacing="8">
                    <Label text="System Login" styleClass="title"/>
                    <Label text="Please enter your credentials to manage services." styleClass="subtitle"/>
                </VBox>

                <VBox spacing="15" maxWidth="380">
                    <TextField fx:id="usernameField" promptText="Username" styleClass="modern-input"/>
                    <PasswordField fx:id="passwordField" promptText="Password" styleClass="modern-input"/>
                </VBox>

                <Button text="Access Dashboard" onAction="#onLogin" styleClass="main-btn" prefWidth="380"/>

                <HBox alignment="CENTER" spacing="10">
                    <Label text="Need an account?" styleClass="subtitle"/>
                    <Hyperlink text="Register Now" onAction="#onGoToRegister" style="-fx-text-fill: #0984e3;"/>
                </HBox>

                <Separator maxWidth="300"/>

                <Button text="🌙 Switch Theme" onAction="#onToggleDarkMode" styleClass="secondary-btn" prefWidth="200"/>

                <Label fx:id="errorLabel" styleClass="error"/>
            </VBox>
        </HBox>
    </center>
</BorderPane>