<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="controller.HandymanDashboardController">

    <top>
        <ToolBar>
            <Label text="Handyman Dashboard" styleClass="title"/>
            <Pane HBox.hgrow="ALWAYS"/>
            <Label fx:id="ratingLabel"/>
            <Button text="Toggle Dark Mode" onAction="#onToggleDarkMode" styleClass="secondary"/>
            <Button text="Logout" onAction="#onBackToLogin"/>
        </ToolBar>
    </top>

    <center>
        <VBox spacing="15">
            <padding><Insets top="20" right="20" bottom="20" left="20"/></padding>

            <Label fx:id="welcomeLabel" styleClass="subtitle"/>
            <Label fx:id="ratingBreakdownLabel"/>

            <Label text="Your Bookings:" styleClass="subtitle"/>
            <TableView fx:id="bookingsTable">
                <columns>
                    <TableColumn fx:id="idColumn" text="Booking ID" prefWidth="80"/>
                    <TableColumn fx:id="customerColumn" text="Customer ID" prefWidth="80"/>
                    <TableColumn fx:id="dateColumn" text="Date/Time" prefWidth="160"/>
                    <TableColumn fx:id="statusColumn" text="Status" prefWidth="100"/>
                    <TableColumn fx:id="addressColumn" text="Address" prefWidth="220"/>
                    <TableColumn fx:id="priceColumn" text="Price" prefWidth="80"/>
                </columns>
            </TableView>

            <HBox spacing="10" alignment="CENTER">
                <Button text="Accept" onAction="#onAccept"/>
                <Button text="Complete" onAction="#onComplete"/>
                <Button text="Cancel" onAction="#onCancel"/>
                <Button text="Reschedule" onAction="#onReschedule" styleClass="secondary"/>
            </HBox>

            <Separator/>

            <Label text="Your Services:" styleClass="subtitle"/>
            <TableView fx:id="servicesTable">
                <columns>
                    <TableColumn fx:id="serviceIdColumn" text="Service ID" prefWidth="80"/>
                    <TableColumn fx:id="serviceTitleColumn" text="Title" prefWidth="200"/>
                    <TableColumn fx:id="serviceCityColumn" text="City" prefWidth="120"/>
                    <TableColumn fx:id="servicePriceColumn" text="Price" prefWidth="80"/>
                    <TableColumn fx:id="serviceActiveColumn" text="Status" prefWidth="100"/>
                </columns>
            </TableView>

            <Label fx:id="infoLabel" styleClass="error"/>
        </VBox>
    </center>
</BorderPane>
